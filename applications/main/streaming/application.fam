App(
    appid="streaming",
    name="Streaming",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="streaming_app",
    requires=["gui", "wifi"],
    # The device-scan scene reuses a list view that lives in the WiFi app's
    # directory. That app is not built in this fork, so the two GUI-only files
    # (canvas drawing and input handling, no radio code) are compiled here.
    sources=[
        "*.c*",
        "../wlan_app/views/wlan_lan_view.c",
        "../wlan_app/views/wlan_view_common.c",
    ],
    stack_size=16 * 1024,
    order=84,
    icon="A_Streaming_14",
    fap_category="Media",
    fap_private_libs=[
        Lib(
            name="helix",
            sources=["*.c"],
            fap_include_paths=["."],
            cdefines=[
                "ARDUINO",
            ],
            cflags=[
                "-w",
                "-Wno-error=implicit-function-declaration",
                "-Wno-error=incompatible-pointer-types",
                "-Wno-error=int-conversion",
                "-Wno-error=pointer-sign",
                "-Wno-error=unused-variable",
                "-Wno-error=unused-function",
                "-Wno-error=unused-but-set-variable",
                "-Wno-error=unused-parameter",
                "-Wno-error=discarded-qualifiers",
            ],
        ),
    ],
)
