App(
    appid="wifi_lab",
    name="WiFi Lab",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="wifi_lab_app",
    requires=["gui", "storage", "wifi"],
    # The tools reuse upstream Wi-Fi engines from the wlan app directory.
    # wlan_view_common.c, used by the sniffer view, is already compiled by
    # Streaming.
    sources=[
        "*.c*",
        "../wlan_app/wlan_webfs.c",
        "../wlan_app/wlan_smb.c",
        "../wlan_app/wlan_netscan.c",
        "../wlan_app/wlan_androidtv.c",
        "../wlan_app/views/wlan_androidtv_remote_view.c",
        "../wlan_app/wlan_airprint.c",
        "../wlan_app/wlan_pcap.c",
        "../wlan_app/wlan_pcap_rec.c",
        "../wlan_app/views/wlan_sniffer_view.c",
    ],
    stack_size=8 * 1024,
    icon="A_Sub1ghz_14",
    order=67,
)
