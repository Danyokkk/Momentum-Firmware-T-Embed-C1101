App(
    appid="subghz_remote",
    name="Sub-GHz Remote",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="subghz_remote_app",
    icon="A_SubGHzRemote_14",
    order=11,
    requires=[
        "gui",
        "dialogs",
        "subghz",
    ],
    # helpers/txrx/subghz_txrx.c is upstream's bundled copy of the Sub-GHz
    # app's TX/RX helper (needed when this is a standalone FAP). Built into the
    # image it would define the same globals as
    # ../subghz/helpers/subghz_txrx.c, so it is not compiled; the app includes
    # and links the Sub-GHz app's helper instead (lab TX gating included).
    sources=[
        "*.c*",
        "!helpers/txrx/subghz_txrx.c",
    ],
    stack_size=2 * 1024,
    targets=["f32"],
    fap_icon="icon.png",
    fap_author="@gid9798 and @xMasterX",
    fap_description="SubGhz Remote, uses up to 5 .sub files",
    fap_category="Sub-GHz",
    fap_icon_assets="icons",
    fap_icon_assets_symbol="subghz_remote",
    fap_version="1.8",
    fap_weburl="https://github.com/DarkFlippers/SubGHz_Remote",
)
